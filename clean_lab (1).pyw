# Lab | Data Cleaning and Formatting# Challenge 1: Data Cleaning and Formatting# Exercise 1: Cleaning Column Namesfrom pathlib import Pathimport pandas as pdDATA_URL = "https://raw.githubusercontent.com/data-bootcamp-v4/data/main/file1.csv"DEFAULT_OUTPUT_PATH = Path("cleaned_customer_data.csv")def load_data(source: str | Path = DATA_URL) -> pd.DataFrame:    """Load the customer dataset from a URL or a local file path."""    return pd.read_csv(source)def clean_column_names(dataframe: pd.DataFrame) -> pd.DataFrame:    """Standardize column names using lowercase snake_case notation."""    cleaned_data = dataframe.copy()    cleaned_data.columns = (        cleaned_data.columns.str.strip().str.lower().str.replace(" ", "_", regex=False)    )    cleaned_data.columns = [        "state" if column_name == "st" else column_name        for column_name in cleaned_data.columns    ]    return cleaned_data# Exercise 2: Cleaning invalid Valuesdef clean_invalid_values(dataframe: pd.DataFrame) -> pd.DataFrame:    """Standardize inconsistent categorical and string values.    This function intentionally does not handle missing values; missing-value    treatment is performed in ``handle_missing_values``.    """    cleaned_data = dataframe.copy()    cleaned_data["gender"] = cleaned_data["gender"].replace(        {"Femal": "F", "female": "F", "Male": "M"}    )    cleaned_data["state"] = cleaned_data["state"].replace(        {"AZ": "Arizona", "Cali": "California", "WA": "Washington"}    )    cleaned_data["education"] = cleaned_data["education"].replace(        {"Bachelors": "Bachelor"}    )    cleaned_data["customer_lifetime_value"] = cleaned_data[        "customer_lifetime_value"    ].str.replace("%", "", regex=False)    cleaned_data["vehicle_class"] = cleaned_data["vehicle_class"].replace(        {"Sports Car": "Luxury", "Luxury SUV": "Luxury", "Luxury Car": "Luxury"}    )    return cleaned_data# Exercise 3: Formatting data typesdef format_data_types(dataframe: pd.DataFrame) -> pd.DataFrame:    """Convert columns to appropriate numeric formats."""    formatted_data = dataframe.copy()    formatted_data["customer_lifetime_value"] = pd.to_numeric(        formatted_data["customer_lifetime_value"], errors="coerce"    )    # For values such as 1/5/00, the number of complaints is the middle value.    formatted_data["number_of_open_complaints"] = (        formatted_data["number_of_open_complaints"].str.split("/").str[1]    )    formatted_data["number_of_open_complaints"] = pd.to_numeric(        formatted_data["number_of_open_complaints"], errors="coerce"    )    return formatted_data# Exercise 4: Dealing with Null valuesdef handle_missing_values(dataframe: pd.DataFrame) -> pd.DataFrame:    """Handle missing values and convert all numeric columns to integers.    Completely empty rows are removed. Numeric missing values are replaced by    the column median because it is less sensitive to outliers. Categorical    missing values are replaced by the column mode.    """    cleaned_data = dataframe.dropna(how="all").copy()    numeric_columns = cleaned_data.select_dtypes(include="number").columns    categorical_columns = cleaned_data.select_dtypes(exclude="number").columns    for column_name in numeric_columns:        cleaned_data[column_name] = cleaned_data[column_name].fillna(            cleaned_data[column_name].median()        )    for column_name in categorical_columns:        if cleaned_data[column_name].isna().any():            mode_value = cleaned_data[column_name].mode(dropna=True).iloc[0]            cleaned_data[column_name] = cleaned_data[column_name].fillna(mode_value)    # Final requirement from the lab: numeric variables must be integers.    for column_name in numeric_columns:        cleaned_data[column_name] = cleaned_data[column_name].round().astype(int    return cleaned_data#Exercise 5: Dealing with duplicatesdef remove_duplicates(dataframe: pd.DataFrame) -> pd.DataFrame:    """Remove complete duplicate rows and reset the index."""    return dataframe.drop_duplicates(keep="first").reset_index(drop=True)def clean_data(dataframe: pd.DataFrame) -> pd.DataFrame:    """Apply all cleaning steps in the required order."""    cleaned_data = clean_column_names(dataframe)    cleaned_data = clean_invalid_values(cleaned_data)    cleaned_data = format_data_types(cleaned_data)    cleaned_data = handle_missing_values(cleaned_data)    cleaned_data = remove_duplicates(cleaned_data)    return cleaned_datadef retention_analysis(dataframe: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:    """Identify high-claim and low-CLV customers and return summary statistics."""    high_claim_threshold = dataframe["total_claim_amount"].quantile(0.75)    low_clv_threshold = dataframe["customer_lifetime_value"].quantile(0.25)    target_customers = dataframe[        (dataframe["total_claim_amount"] > high_claim_threshold)        & (dataframe["customer_lifetime_value"] < low_clv_threshold)    ].copy()    summary_statistics = target_customers[        ["total_claim_amount", "customer_lifetime_value"]    ].describe()    return target_customers, summary_statisticsdef main(    source: str | Path = DATA_URL,    output_path: str | Path = DEFAULT_OUTPUT_PATH,) -> pd.DataFrame:    """Run the complete cleaning workflow and save the cleaned dataset."""    raw_data = load_data(source)    print("Missing values before cleaning:")    print(raw_data.isnull().sum())    print(f"\nDuplicate rows before cleaning: {raw_data.duplicated().sum()}")    cleaned_data = clean_data(raw_data)    cleaned_data.to_csv(output_path, index=False)    target_customers, summary_statistics = retention_analysis(cleaned_data)    print("\nMissing values after cleaning:")    print(cleaned_data.isnull().sum())    print(f"\nDuplicate rows after cleaning: {cleaned_data.duplicated().sum()}")    print(        f"\nCleaned dataset: {cleaned_data.shape[0]} rows, "        f"{cleaned_data.shape[1]} columns"    )    print(f"CSV saved to: {output_path}")    print("\nCustomers with high claim amounts and low customer lifetime value:")    print(target_customers.to_string(index=False))    print("\nDescriptive statistics:")    print(summary_statistics)    return cleaned_dataif __name__ == "__main__":    main()